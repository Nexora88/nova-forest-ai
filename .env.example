# ==========================================
# NOVA-FOREST AI — ENVIRONMENT CONFIGURATION
# ==========================================

# ---------- Core backend ----------
NOVA_API_BASE=
NOVA_ENV=production

# ---------- Weather / forecast ----------
# Open-Meteo: API key NOT required for normal non-commercial use.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---------- NASA FIRMS active fire ----------
# Free MAP_KEY required for FIRMS API / map services.
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# ---------- Copernicus Data Space / Sentinel-2 ----------
# Required for Sentinel-2 Statistical API, NDVI/NDMI time series, etc.
# OAuth client credentials; keep these server-side only.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SENTINELHUB_BASE_URL=https://sh.dataspace.copernicus.eu
CDSE_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1

# ---------- OpenStreetMap / Nominatim ----------
# No API key for basic public Nominatim use.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Nova-Forest-AI/1.0
NOMINATIM_EMAIL=

# ---------- Web Push / background alerts ----------
# Keep VAPID_PRIVATE_KEY_B64 and SUPABASE_ADMIN_KEY server-side only.
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:hello@nexora88.com
SUPABASE_URL=
SUPABASE_ADMIN_KEY=
ALERT_DEFAULT_THRESHOLD=70
ALERT_CHECK_INTERVAL_SECONDS=300

# ---------- Nova Copilot: independent model agents ----------
# The API makes separate model requests; each configured model must exist on this host.
# Production must use a private HTTPS gateway reachable from the backend, not a developer's localhost.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
AGRO_AGENT_MODEL=
ECO_AGENT_MODEL=
WRITER_AGENT_MODEL=

# Strong random secret for an external scheduler calling GET /api/notifications/cron/run.
# A secret does not create a schedule by itself; configure a scheduler separately.
NOVA_CRON_SECRET=

# ---------- Optional geocoding / routing ----------
GEOCODING_API_KEY=
ROUTING_API_KEY=

# ---------- Optional analytics / monitoring ----------
SENTRY_DSN=

# ---------- Browser application auth ----------
# Public/publishable key only; RLS must protect every exposed table.
SUPABASE_ANON_KEY=
# SUPABASE_ADMIN_KEY is server-only; never expose it in frontend JavaScript.
