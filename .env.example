# ==========================================
# NOVA-FOREST AI — ENVIRONMENT CONFIGURATION
# ==========================================

# ---------- Core backend ----------
NOVA_API_BASE=
NOVA_ENV=production

# ---------- Weather / forecast ----------
# Open-Meteo: API key NOT required for normal non-commercial use.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---------- NASA FIRMS active fire ----------
# Free MAP_KEY required for FIRMS API / map services.
# Request it from the official NASA FIRMS account page.
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# ---------- Copernicus Data Space / Sentinel-2 ----------
# Required for Sentinel-2 Statistical API, NDVI/NDMI time series, etc.
# OAuth client credentials; keep these server-side only.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SENTINELHUB_BASE_URL=https://sh.dataspace.copernicus.eu
CDSE_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1

# ---------- OpenStreetMap / Nominatim ----------
# No API key for basic public Nominatim use.
# Identify requests with a descriptive User-Agent and respect usage limits.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Nova-Forest-AI/1.0 (contact@example.com)
NOMINATIM_EMAIL=

# ---------- Email alerts ----------
# SMTP credentials required only if email notifications are enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---------- Telegram alerts ----------
# Bot token + destination Chat ID required only if Telegram alerts are enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ---------- SMS alerts ----------
# Optional. Required only if SMS alerts are enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Alert policy ----------
# Used as the default threshold for automatic environmental alerts.
ALERT_DEFAULT_THRESHOLD=70
ALERT_CHECK_INTERVAL_SECONDS=300

# ---------- Optional geocoding / routing ----------
# Keep empty unless the feature is enabled.
GEOCODING_API_KEY=
ROUTING_API_KEY=

# ---------- Optional analytics / monitoring ----------
# Leave empty until a provider is intentionally added.
SENTRY_DSN=

# ---------- Optional application auth ----------
# Only needed if authenticated user accounts are introduced.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
