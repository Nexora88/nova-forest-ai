# NexoraWildfire AI — backend secrets (NEVER commit a real .env)
# Core
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server-only key for backend database access and Supabase token verification; NEVER use in frontend.
SUPABASE_ADMIN_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Optional: NASA FIRMS active-fire observations
NASA_FIRMS_MAP_KEY=

# Optional: Copernicus Data Space / Sentinel-2 credentials
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional: Web Push VAPID
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
# Base64url-encoded PEM private key expected by push_service.py.
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:you@example.com

# Optional: external AI provider, only if you add a real model
AI_API_KEY=

# Production hardening
ALLOWED_ORIGINS=https://nexora88.github.io
MAX_REQUEST_BYTES=1048576
