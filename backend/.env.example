# NexoraWildfire AI — backend secrets (copy to a private .env locally or hosting environment variables)
# NEVER commit real values and NEVER put server-only values in frontend JavaScript.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server-only key used by backend for privileged database operations. Never expose to browser.
SUPABASE_ADMIN_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# NASA FIRMS active-fire observations (optional; request your own key from NASA FIRMS)
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY

# Copernicus Data Space / Sentinel-2 (optional; use the exact names consumed by the backend)
CDSE_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID
CDSE_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET

# External asynchronous GIS worker (required for queued NDVI/raster jobs)
NEXORA_WORKER_URL=
NEXORA_WORKER_TOKEN=

# Optional server-side allowlist; comma-separated Supabase user UUIDs, not email addresses.
NEXORA_ENTERPRISE_USER_IDS=

# Web Push VAPID credentials (optional; private key stays server-side)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:you@example.com

# Production controls
ALLOWED_ORIGINS=https://nexora88.github.io,https://nova-forest-ai.vercel.app
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=12

# No AI provider is currently required for the core data routes.
# Add a provider-specific key only after selecting and reviewing the provider.
AI_API_KEY=

# Real YOLOv8 fire/smoke inference (ML container only; third-party model license applies)
NEXORA_YOLO_MODEL_PATH=
NEXORA_YOLO_HF_REPO_ID=rabahdev/fire-smoke-yolov8n
NEXORA_YOLO_HF_FILENAME=best.pt
NEXORA_YOLO_CONFIDENCE=0.25

# Independent Agro-Agent / Eco-Agent / Writer-Agent model calls (OpenAI-compatible API)
NOVA_AGENT_API_BASE=
NOVA_AGENT_API_KEY=
NOVA_AGRO_MODEL=
NOVA_ECO_MODEL=
NOVA_WRITER_MODEL=

# SMS / WhatsApp delivery (Twilio; require explicit user opt-in in the app)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# Stripe subscriptions (set real Stripe Price IDs; do not invent prices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_ENTERPRISE_ID=
NOVA_PUBLIC_APP_URL=https://nova-forest-ai.vercel.app

# If using an external scheduler to trigger alerts, use a long random secret.
NOVA_ALERT_CRON_SECRET=
