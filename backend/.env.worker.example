# Copy to .env.worker on the VPS. Never commit the real .env.worker.
# Generate a long random value and set the same value as NEXORA_WORKER_TOKEN
# in the Vercel backend project's Production environment.
NEXORA_WORKER_TOKEN=replace-with-a-long-random-secret
REDIS_URL=redis://redis:6379/0

# Required for processed Sentinel-2 / CDSE statistics and raster jobs.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Required for the private PNG artifact in Supabase Storage.
SUPABASE_URL=
SUPABASE_ADMIN_KEY=
NEXORA_ARTIFACT_BUCKET=nexora-job-artifacts

# Required for live NASA FIRMS hotspots (separate from Sentinel-2).
FIRMS_MAP_KEY=

# Enterprise PDF output: private bucket and verified Resend email sender
SUPABASE_REPORTS_BUCKET=enterprise-reports
RESEND_API_KEY=
REPORT_EMAIL_FROM=
